{
    "root": true,
    "env": {
        "es2021": true,
        "node": true,
        "react-native/react-native": true
    },
    "extends": ["eslint:recommended", "plugin:react/recommended"],
    "plugins": ["react", "react-native", "tailwindcss"],
    "rules": {
        "tailwindcss/cssConflict": "off"
    },
    "settings": {
        "react": {
            "version": "detect"
        }
    }
}
